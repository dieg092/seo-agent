generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  schemas    = ["seo_agent"]
  extensions = [vector]
}

model SearchConsoleSnapshot {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  page        String
  query       String
  clicks      Int
  impressions Int
  ctr         Float
  position    Float
  createdAt   DateTime @default(now())

  @@unique([date, page, query])
  @@index([date])
  @@index([page])
  @@schema("seo_agent")
}

// Totales por página y tipo de búsqueda (web, image, video, news, discover, googleNews).
// Los totales nunca se calculan sumando consultas: salen siempre de aquí.
model SearchConsolePageDaily {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  page        String
  type        String
  clicks      Int
  impressions Int
  ctr         Float
  position    Float?
  isFinal     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date, page, type])
  @@index([date])
  @@index([page])
  @@schema("seo_agent")
}

// Detalle por consulta de image y video. El de web sigue en SearchConsoleSnapshot.
model SearchConsoleQueryTyped {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  page        String
  query       String
  type        String
  isBrand     Boolean  @default(false)
  clicks      Int
  impressions Int
  ctr         Float
  position    Float?
  isFinal     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date, page, query, type])
  @@index([date])
  @@index([page])
  @@schema("seo_agent")
}

// Segmentos por dispositivo y país (solo web).
model SearchConsoleSegmentDaily {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  page        String
  device      String
  country     String
  type        String
  clicks      Int
  impressions Int
  ctr         Float
  position    Float?
  isFinal     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date, page, device, country, type])
  @@index([date])
  @@index([page])
  @@schema("seo_agent")
}

// Calidad de los datos por día, tipo y dataset (p. ej. "page", "query", "segment").
model GscDataQuality {
  id                String   @id @default(uuid())
  date              DateTime @db.Date
  type              String
  dataset           String
  rowsReturned      Int
  capped            Boolean  @default(false)
  pageTotalClicks   Int?
  queryDetailClicks Int?
  // 1 - detalle/total; null si no hay clics totales
  anonymizedShare   Float?
  isFinal           Boolean  @default(false)
  fetchedAt         DateTime @default(now())

  @@unique([date, type, dataset])
  @@index([date])
  @@schema("seo_agent")
}

// Resultado de la URL Inspection API. Las URLs privadas no se inspeccionan nunca.
model UrlInspection {
  id                 String    @id @default(uuid())
  url                String
  inspectedAt        DateTime  @default(now())
  inSitemap          Boolean
  // por qué se inspecciona: tracked, recent, commercial, orphan o sweep
  reason             String
  verdict            String?
  coverageState      String?
  indexingState      String?
  robotsTxtState     String?
  pageFetchState     String?
  lastCrawlTime      DateTime?
  googleCanonical    String?
  userCanonical      String?
  crawledAs          String?
  richResultsVerdict String?
  richResultsItems   Json?
  error              String?

  @@index([url, inspectedAt])
  @@index([inspectedAt])
  @@schema("seo_agent")
}

// Estado de los sitemaps según GSC.
model GscSitemapStatus {
  id             String    @id @default(uuid())
  path           String
  checkedAt      DateTime  @default(now())
  lastSubmitted  DateTime?
  lastDownloaded DateTime?
  isPending      Boolean
  errors         Int
  warnings       Int
  contents       Json?
  raw            Json

  @@index([path, checkedAt])
  @@schema("seo_agent")
}

// Sonda diaria contra producción. Las URLs privadas se guardan redactadas.
model ProductionProbeResult {
  id         String   @id @default(uuid())
  runAt      DateTime @default(now())
  url        String
  // sitemap, private-sample o gsc-private
  kind       String
  status     Int?
  finalUrl   String?
  metaRobots String?
  xRobotsTag String?
  canonical  String?
  ok         Boolean
  reason     String?

  @@index([runAt])
  @@schema("seo_agent")
}

// Rastreo semanal propio (§11): una fila por URL pública y ejecución. Solo se piden
// rutas públicas; la canónica y la redirección se guardan redactadas si son privadas.
model CrawlPage {
  id               String   @id @default(uuid())
  runAt            DateTime
  url              String
  inSitemap        Boolean
  // 0 si viene del sitemap; si no, saltos desde el sitemap
  depth            Int
  blockedByRobots  Boolean  @default(false)
  status           Int?
  redirectTo       String?
  contentType      String?
  bytes            Int?
  durationMs       Int?
  canonical        String?
  metaRobots       String?
  xRobotsTag       String?
  title            String?
  h1               String[]
  // enlaces <a> a rutas públicas de la web, normalizados y sin repetir
  internalLinks    String[]
  // enlaces a rutas privadas: no se guardan, solo se cuentan
  privateLinkCount Int      @default(0)
  error            String?
  createdAt        DateTime @default(now())

  @@unique([runAt, url])
  @@index([runAt])
  @@index([url])
  @@schema("seo_agent")
}

// Página privada vista fuera de su sitio. La URL real solo se guarda cifrada (AES-256-GCM).
model PrivateIncident {
  id           String    @id @default(uuid())
  urlHmac      String    @unique
  urlEncrypted String
  firstSeenAt  DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  sources      String[]
  resolvedAt   DateTime?

  @@index([resolvedAt])
  @@schema("seo_agent")
}

// GA4 por página de entrada y canal, con eventos clave.
model AnalyticsLandingDaily {
  id              String   @id @default(uuid())
  date            DateTime @db.Date
  landingPage     String
  channel         String
  sessions        Int
  engagedSessions Int
  keyEvents       Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([date, landingPage, channel])
  @@index([date])
  @@schema("seo_agent")
}

// Embudo orgánico de la app (vista seo_funnel_daily) por día de Madrid, página de
// entrada del primer contacto y canal. Sin página de entrada guardada: 'unknown'.
model FunnelOrganicDaily {
  id                     String   @id @default(uuid())
  date                   DateTime @db.Date
  landingPath            String
  channel                String
  registros              Int
  bodasPublicadas        Int
  primerasConfirmaciones Int
  pagos                  Int
  revenueCents           Int
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([date, landingPath, channel])
  @@index([date])
  @@index([landingPath])
  @@schema("seo_agent")
}

model AnalyticsSnapshot {
  id              String   @id @default(uuid())
  date            DateTime @db.Date
  page            String
  channel         String
  sessions        Int
  engagedSessions Int
  conversions     Int
  createdAt       DateTime @default(now())

  @@unique([date, page, channel])
  @@index([date])
  @@schema("seo_agent")
}

model SitemapAuditResult {
  id           String   @id @default(uuid())
  runAt        DateTime @default(now())
  urlCount     Int
  staleEntries Int
  errors       Json
  @@schema("seo_agent")
}

model RobotsAuditResult {
  id      String   @id @default(uuid())
  runAt   DateTime @default(now())
  isValid Boolean
  errors  Json
  @@schema("seo_agent")
}

model StructuredDataAuditResult {
  id         String   @id @default(uuid())
  runAt      DateTime @default(now())
  url        String
  schemaType String
  isValid    Boolean
  errors     Json

  @@index([url])
  @@schema("seo_agent")
}

model Opportunity {
  id                          String    @id @default(uuid())
  source                      String
  findingType                 String
  stableKey                   String    @unique
  sourceRefId                 String
  title                       String
  detail                      Json
  impactScore                 Int
  confidenceScore             Float
  effortScore                 Int
  priorityScore               Float
  status                      String
  firstDetectedAt             DateTime  @default(now())
  resolvedAt                  DateTime?
  reviewedNoActionAt          DateTime?
  reviewedNoActionContentHash String?
  reviewedNoActionReason      String?
  // Ciclo de vida de la spec §6 (src/opportunity/lifecycle.ts). `status` (open/resolved)
  // se mantiene como hasta ahora para tier1, tier2 y el panel.
  state                       String    @default("open")
  stateChangedAt              DateTime  @default(now())
  confirmations               Int       @default(0)
  absences                    Int       @default(0)
  oscillations                Int       @default(0)
  oscillationsSince           DateTime?
  dismissedValue              Float?
  staleAt                     DateTime?
  // Atributos del catálogo (src/prioritization/catalog.ts) y factores de la prioridad §12.2.
  page                        String?
  operation                   String?
  autonomy                    String    @default("A2")
  lane                        String    @default("technical")
  severity                    String    @default("medium")
  confidence                  String    @default("observed")
  businessValue               Float     @default(1)
  priorityFactors             Json?

  @@index([status])
  @@index([state])
  @@index([lane])
  @@schema("seo_agent")
}

model PerformanceAuditResult {
  id               String   @id @default(uuid())
  url              String
  performanceScore Int?
  lcp              Float?
  cls              Float?
  inp              Float?
  errors           Json?
  runAt            DateTime @default(now())

  @@index([url])
  @@index([runAt])
  @@schema("seo_agent")
}

model AppliedChange {
  id                     String   @id @default(uuid())
  opportunityStableKey   String
  findingType            String
  prUrl                  String
  prNumber               Int
  status                 String
  filePath               String?
  previousContent        String?
  revertsAppliedChangeId String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([opportunityStableKey])
  @@index([status])
  @@schema("seo_agent")
}

model ArticleEmbedding {
  id          String                       @id @default(uuid())
  slug        String                       @unique
  url         String
  contentHash String
  embedding   Unsupported("vector(1024)")?
  updatedAt   DateTime                     @updatedAt

  @@schema("seo_agent")
}

model LinkSuggestion {
  id         String   @id @default(uuid())
  sourceSlug String
  targetSlug String
  similarity Float
  stableKey  String   @unique
  status     String
  createdAt  DateTime @default(now())

  @@index([status])
  @@schema("seo_agent")
}

model GraduationRecord {
  id                String   @id @default(uuid())
  findingType       String   @unique
  consecutiveGood   Int      @default(0)
  autoMergeEligible Boolean  @default(false)
  updatedAt         DateTime @updatedAt

  @@schema("seo_agent")
}

model ImpactMeasurement {
  id              String   @id @default(uuid())
  appliedChangeId String   @unique
  findingType     String
  outcome         String
  beforeMetric    Float
  afterMetric     Float
  measuredAt      DateTime @default(now())

  @@schema("seo_agent")
}

model Alert {
  id           String   @id @default(uuid())
  type         String
  subject      String
  body         String
  acknowledged Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([acknowledged])
  @@schema("seo_agent")
}

model WorkflowHeartbeat {
  id           String   @id @default(uuid())
  workflowName String   @unique
  lastRunAt    DateTime @default(now())
  lastStatus   String
  lastRunUrl   String?
  updatedAt    DateTime @updatedAt

  @@schema("seo_agent")
}

// Fase 3 (anexo C.5): enlace entre un hallazgo y su tarea de Órbita. El puente
// (scripts/seo-bridge.ts) lo crea al proponer la tarea y lo cierra cuando la
// tarea termina, se cancela o caduca. Una Opportunity tiene como mucho un
// enlace abierto (closedAt null).
model SeoTaskLink {
  id            String    @id @default(uuid())
  opportunityId String
  stableKey     String
  orbitaTaskId  String    @unique
  findingType   String
  operation     String?
  page          String?
  lane          String
  autonomy      String
  contract      Json
  // último estado leído de Órbita: todo, in_progress, blocked, done, cancelled o missing
  taskStatus    String    @default("todo")
  createdAt     DateTime  @default(now())
  lastSyncedAt  DateTime  @default(now())
  expiresAt     DateTime
  closedAt      DateTime?
  // done, cancelled, expired, resolved o missing
  closeReason   String?

  @@index([stableKey])
  @@index([closedAt])
  @@index([createdAt])
  @@schema("seo_agent")
}

// Fase 4 (§14): interruptor general, pausa por carril y freno automático. Fila
// única (id "global"). Cada decisión queda en Alert; sin tabla de historial.
model SeoControl {
  id           String    @id @default("global")
  // on | off
  masterSwitch String    @default("on")
  pausedLanes  String[]  @default([])
  // off | tripped
  brakeState   String    @default("off")
  brakeReason  String?
  trippedAt    DateTime?
  trippedBy    String?
  updatedAt    DateTime  @updatedAt

  @@schema("seo_agent")
}

// Fase 4 (§13): un despliegue de producción de wedding-invite-2 y los commits
// seo(...) de todo el rango desplegado. Lo escribe la CI de main (rol seo_ci).
model DeployEvent {
  commitSha    String   @id
  deployedAt   DateTime @default(now())
  runUrl       String?
  seoChangeIds String[] @default([])

  @@index([deployedAt])
  @@schema("seo_agent")
}

// Fase 5 (§16.1-16.2): consultas de GSC (no-marca, 90 días) clasificadas por
// intención y agrupadas en clústeres con embeddings bge-m3. Las reconstruye
// scripts/build-keywords.ts cada mes; el embedding se guarda para no pedirlo otra vez.
model KeywordCandidate {
  id               String   @id @default(uuid())
  query            String   @unique
  // transactional | commercial | informational | comparison | image
  intent           String
  impressions90d   Int
  clicks90d        Int
  avgPosition      Float
  bestPage         String?
  bestPagePosition Float?
  // low | medium | high (fuente: impresiones de GSC en 90 días)
  demand           String
  clusterId        String?
  embedding        Float[]  @default([])
  updatedAt        DateTime @updatedAt

  @@index([clusterId])
  @@schema("seo_agent")
}

model TopicCluster {
  id               String   @id @default(uuid())
  label            String
  // intención dominante (por impresiones) de sus consultas
  intent           String
  mainPage         String?
  mainPagePosition Float?
  hasProductPage   Boolean
  queryCount       Int
  impressions90d   Int
  clicks90d        Int
  updatedAt        DateTime @updatedAt

  @@schema("seo_agent")
}

// Fase 5 (§16.7): oportunidades de enlace. La investigación y el borrador son
// automáticos (A2); el contacto lo hace siempre el fundador (A3, ≤ 5 a la semana).
// El crawler semanal comprueba que el enlace conseguido existe.
model BacklinkOpportunity {
  id             String    @id @default(uuid())
  domain         String
  candidatePage  String?
  // directorio | blog | proveedor | recurso | mencion
  kind           String
  relevance      String
  reason         String
  probability    String
  risks          String?
  // idea | propuesta | contactado | conseguido | descartado
  status         String    @default("idea")
  actions        String?
  verifiedLink   String?
  verifiedAt     DateTime?
  lastCheckedAt  DateTime?
  outcome        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([domain, candidatePage])
  @@index([status])
  @@schema("seo_agent")
}

// Fase 6 (§10.6): Bing Webmaster. Bing agrega por semana (Date = inicio del
// periodo). Las URLs privadas se guardan redactadas, como en GSC.
model BingQueryStat {
  id                    String   @id @default(uuid())
  date                  DateTime @db.Date
  query                 String
  isBrand               Boolean  @default(false)
  impressions           Int
  clicks                Int
  avgImpressionPosition Float
  avgClickPosition      Float?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([date, query])
  @@index([date])
  @@schema("seo_agent")
}

model BingPageStat {
  id                    String   @id @default(uuid())
  date                  DateTime @db.Date
  page                  String
  impressions           Int
  clicks                Int
  avgImpressionPosition Float
  avgClickPosition      Float?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([date, page])
  @@index([date])
  @@schema("seo_agent")
}

model BingCrawlStat {
  date               DateTime @id @db.Date
  crawledPages       Int
  inIndex            Int
  inLinks            Int
  code2xx            Int
  code301            Int
  code302            Int
  code4xx            Int
  code5xx            Int
  blockedByRobotsTxt Int
  crawlErrors        Int
  allOtherCodes      Int
  updatedAt          DateTime @updatedAt

  @@schema("seo_agent")
}

// Fase 5 (§16.3): estructura de páginas públicas de los competidores. Solo
// estructura (rutas, title, encabezados, tipos de schema), nunca el texto: no se
// copia contenido. Es entrada contaminada: lo que sale de aquí nunca es A1.
model CompetitorPage {
  id          String   @id @default(uuid())
  domain      String
  url         String   @unique
  path        String
  status      Int
  title       String?
  h1          String?
  headings    String[] @default([])
  jsonLdTypes String[] @default([])
  wordCount   Int      @default(0)
  lang        String?
  embedding   Float[]  @default([])
  fetchedAt   DateTime @default(now())

  @@index([domain, fetchedAt])
  @@schema("seo_agent")
}
