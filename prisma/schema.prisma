generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  schemas    = ["seo_agent"]
  extensions = [vector]
}

model SearchConsoleSnapshot {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  page        String
  query       String
  clicks      Int
  impressions Int
  ctr         Float
  position    Float
  createdAt   DateTime @default(now())

  @@unique([date, page, query])
  @@index([date])
  @@index([page])
  @@schema("seo_agent")
}

// Totales por página y tipo de búsqueda (web, image, video, news, discover, googleNews).
// Los totales nunca se calculan sumando consultas: salen siempre de aquí.
model SearchConsolePageDaily {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  page        String
  type        String
  clicks      Int
  impressions Int
  ctr         Float
  position    Float?
  isFinal     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date, page, type])
  @@index([date])
  @@index([page])
  @@schema("seo_agent")
}

// Detalle por consulta de image y video. El de web sigue en SearchConsoleSnapshot.
model SearchConsoleQueryTyped {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  page        String
  query       String
  type        String
  isBrand     Boolean  @default(false)
  clicks      Int
  impressions Int
  ctr         Float
  position    Float?
  isFinal     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date, page, query, type])
  @@index([date])
  @@index([page])
  @@schema("seo_agent")
}

// Segmentos por dispositivo y país (solo web).
model SearchConsoleSegmentDaily {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  page        String
  device      String
  country     String
  type        String
  clicks      Int
  impressions Int
  ctr         Float
  position    Float?
  isFinal     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date, page, device, country, type])
  @@index([date])
  @@index([page])
  @@schema("seo_agent")
}

// Calidad de los datos por día, tipo y dataset (p. ej. "page", "query", "segment").
model GscDataQuality {
  id                String   @id @default(uuid())
  date              DateTime @db.Date
  type              String
  dataset           String
  rowsReturned      Int
  capped            Boolean  @default(false)
  pageTotalClicks   Int?
  queryDetailClicks Int?
  // 1 - detalle/total; null si no hay clics totales
  anonymizedShare   Float?
  isFinal           Boolean  @default(false)
  fetchedAt         DateTime @default(now())

  @@unique([date, type, dataset])
  @@index([date])
  @@schema("seo_agent")
}

// Resultado de la URL Inspection API. Las URLs privadas no se inspeccionan nunca.
model UrlInspection {
  id                 String    @id @default(uuid())
  url                String
  inspectedAt        DateTime  @default(now())
  inSitemap          Boolean
  // por qué se inspecciona: tracked, recent, commercial, orphan o sweep
  reason             String
  verdict            String?
  coverageState      String?
  indexingState      String?
  robotsTxtState     String?
  pageFetchState     String?
  lastCrawlTime      DateTime?
  googleCanonical    String?
  userCanonical      String?
  crawledAs          String?
  richResultsVerdict String?
  richResultsItems   Json?
  error              String?

  @@index([url, inspectedAt])
  @@index([inspectedAt])
  @@schema("seo_agent")
}

// Estado de los sitemaps según GSC.
model GscSitemapStatus {
  id             String    @id @default(uuid())
  path           String
  checkedAt      DateTime  @default(now())
  lastSubmitted  DateTime?
  lastDownloaded DateTime?
  isPending      Boolean
  errors         Int
  warnings       Int
  contents       Json?
  raw            Json

  @@index([path, checkedAt])
  @@schema("seo_agent")
}

// Sonda diaria contra producción. Las URLs privadas se guardan redactadas.
model ProductionProbeResult {
  id         String   @id @default(uuid())
  runAt      DateTime @default(now())
  url        String
  // sitemap, private-sample o gsc-private
  kind       String
  status     Int?
  finalUrl   String?
  metaRobots String?
  xRobotsTag String?
  canonical  String?
  ok         Boolean
  reason     String?

  @@index([runAt])
  @@schema("seo_agent")
}

// Página privada vista fuera de su sitio. La URL real solo se guarda cifrada (AES-256-GCM).
model PrivateIncident {
  id           String    @id @default(uuid())
  urlHmac      String    @unique
  urlEncrypted String
  firstSeenAt  DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  sources      String[]
  resolvedAt   DateTime?

  @@index([resolvedAt])
  @@schema("seo_agent")
}

// GA4 por página de entrada y canal, con eventos clave.
model AnalyticsLandingDaily {
  id              String   @id @default(uuid())
  date            DateTime @db.Date
  landingPage     String
  channel         String
  sessions        Int
  engagedSessions Int
  keyEvents       Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([date, landingPage, channel])
  @@index([date])
  @@schema("seo_agent")
}

model AnalyticsSnapshot {
  id              String   @id @default(uuid())
  date            DateTime @db.Date
  page            String
  channel         String
  sessions        Int
  engagedSessions Int
  conversions     Int
  createdAt       DateTime @default(now())

  @@unique([date, page, channel])
  @@index([date])
  @@schema("seo_agent")
}

model SitemapAuditResult {
  id           String   @id @default(uuid())
  runAt        DateTime @default(now())
  urlCount     Int
  staleEntries Int
  errors       Json
  @@schema("seo_agent")
}

model RobotsAuditResult {
  id      String   @id @default(uuid())
  runAt   DateTime @default(now())
  isValid Boolean
  errors  Json
  @@schema("seo_agent")
}

model StructuredDataAuditResult {
  id         String   @id @default(uuid())
  runAt      DateTime @default(now())
  url        String
  schemaType String
  isValid    Boolean
  errors     Json

  @@index([url])
  @@schema("seo_agent")
}

model Opportunity {
  id                          String    @id @default(uuid())
  source                      String
  findingType                 String
  stableKey                   String    @unique
  sourceRefId                 String
  title                       String
  detail                      Json
  impactScore                 Int
  confidenceScore             Float
  effortScore                 Int
  priorityScore               Float
  status                      String
  firstDetectedAt             DateTime  @default(now())
  resolvedAt                  DateTime?
  reviewedNoActionAt          DateTime?
  reviewedNoActionContentHash String?
  reviewedNoActionReason      String?

  @@index([status])
  @@schema("seo_agent")
}

model PerformanceAuditResult {
  id               String   @id @default(uuid())
  url              String
  performanceScore Int?
  lcp              Float?
  cls              Float?
  inp              Float?
  errors           Json?
  runAt            DateTime @default(now())

  @@index([url])
  @@index([runAt])
  @@schema("seo_agent")
}

model AppliedChange {
  id                     String   @id @default(uuid())
  opportunityStableKey   String
  findingType            String
  prUrl                  String
  prNumber               Int
  status                 String
  filePath               String?
  previousContent        String?
  revertsAppliedChangeId String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([opportunityStableKey])
  @@index([status])
  @@schema("seo_agent")
}

model ArticleEmbedding {
  id          String                       @id @default(uuid())
  slug        String                       @unique
  url         String
  contentHash String
  embedding   Unsupported("vector(1024)")?
  updatedAt   DateTime                     @updatedAt

  @@schema("seo_agent")
}

model LinkSuggestion {
  id         String   @id @default(uuid())
  sourceSlug String
  targetSlug String
  similarity Float
  stableKey  String   @unique
  status     String
  createdAt  DateTime @default(now())

  @@index([status])
  @@schema("seo_agent")
}

model GraduationRecord {
  id                String   @id @default(uuid())
  findingType       String   @unique
  consecutiveGood   Int      @default(0)
  autoMergeEligible Boolean  @default(false)
  updatedAt         DateTime @updatedAt

  @@schema("seo_agent")
}

model ImpactMeasurement {
  id              String   @id @default(uuid())
  appliedChangeId String   @unique
  findingType     String
  outcome         String
  beforeMetric    Float
  afterMetric     Float
  measuredAt      DateTime @default(now())

  @@schema("seo_agent")
}

model Alert {
  id           String   @id @default(uuid())
  type         String
  subject      String
  body         String
  acknowledged Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([acknowledged])
  @@schema("seo_agent")
}

model WorkflowHeartbeat {
  id           String   @id @default(uuid())
  workflowName String   @unique
  lastRunAt    DateTime @default(now())
  lastStatus   String
  lastRunUrl   String?
  updatedAt    DateTime @updatedAt

  @@schema("seo_agent")
}
