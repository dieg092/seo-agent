# Neon — rama seo-agent, rol limitado al schema seo_agent (Task 2)
DATABASE_URL=
DIRECT_URL=

# Service account de Google con acceso de lectura a GSC + GA4 (Task 4)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Pega la clave privada completa (incluye -----BEGIN PRIVATE KEY-----),
# sustituyendo los saltos de línea reales por \n literales en una sola línea.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# miwebdeboda.com está verificado en Search Console como propiedad de dominio,
# no de URL con prefijo — de ahí el formato sc-domain: (confirmado con
# searchconsole.sites.list() contra la service account real).
GSC_SITE_URL=sc-domain:miwebdeboda.com
GA4_PROPERTY_ID=
SITE_BASE_URL=https://miwebdeboda.com

# Clave para redactar (HMAC) y cifrar (AES-256-GCM) las URLs privadas de las
# webs de boda. Sin ella, los colectores de GSC completo, inspección de URLs,
# GA4 por landing y la sonda de producción no guardan nada. Genérala una vez
# con `openssl rand -hex 32` y guárdala también como secret del repo en GitHub
# (SEO_PRIVATE_URL_KEY). No la cambies: los hmac guardados dejarían de casar.
SEO_PRIVATE_URL_KEY=

# Muestras de URLs privadas (webs de boda de prueba) que la sonda diaria abre
# para comprobar que siguen con noindex. Separadas por comas o espacios. En
# GitHub va como variable del repo (vars.PRIVATE_PROBE_URLS), no como secret.
PRIVATE_PROBE_URLS=

# PageSpeed Insights API key (API key simple, no OAuth) — proyecto miwebdeboda-seo-agent
PAGESPEED_API_KEY=

# Fine-grained PAT scoped ONLY a wedding-invite-2 (Contents + Pull requests:
# Read and write, nada más). Crear en
# https://github.com/settings/personal-access-tokens/new
WEDDING_INVITE_2_PAT=
GITHUB_REPO_OWNER=dieg092
GITHUB_REPO_NAME=wedding-invite-2

# Cloudflare Workers AI — mismas 4 cuentas que ya usa el pipeline de fotos
# de wedding-invite-2 (rotación: 3 gratuitas + 1 de pago como fallback).
# Copiar los valores reales desde wedding-invite-2/.env, no crear nuevas.
CLOUDFLARE_WORKER_AI_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKER_AI_API_TOKEN_2=
CLOUDFLARE_ACCOUNT_ID_2=
CLOUDFLARE_WORKER_AI_API_TOKEN_3=
CLOUDFLARE_ACCOUNT_ID_3=
CLOUDFLARE_WORKER_AI_API_TOKEN_4=
CLOUDFLARE_ACCOUNT_ID_4=
